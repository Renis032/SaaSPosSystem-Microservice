# Used by docker compose (copy to .env in the repo root if you want overrides).

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5000
FRONTEND_PORT=8080

# Domain service ports (compose also publishes these for debugging)
# auth=5001 store=5002 catalog=5003 sales=5004 billing=5005 report=5006

MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_PORT=3306
# Per-service DB names are set in docker-compose (pos_auth, pos_store, …).
# Local runs: each service defaults MYSQL_DATABASE to its own pos_* name.

JWT_SECRET_KEY=a-very-long-random-secret-key-that-is-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=false
SHOW_SQL=false

# Service URLs for local process runs (Compose overrides with Docker DNS names)
AUTH_SERVICE_URL=http://localhost:5001
STORE_SERVICE_URL=http://localhost:5002
CATALOG_SERVICE_URL=http://localhost:5003
SALES_SERVICE_URL=http://localhost:5004
BILLING_SERVICE_URL=http://localhost:5005
REPORT_SERVICE_URL=http://localhost:5006

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_CURRENCY=usd
