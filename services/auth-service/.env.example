# Copy to .env / export in shell before running the backend.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pos_auth
MYSQL_USER=root
MYSQL_PASSWORD=password

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_CURRENCY=usd
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true
